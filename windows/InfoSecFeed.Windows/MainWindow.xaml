<Window x:Class="InfoSecFeed.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="InfoSec Feed" Width="1180" Height="820" MinWidth="760" MinHeight="540"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#0D141D" BorderBrush="#263543"
                BorderThickness="0,0,0,1" Padding="24,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FullDesktopButton" Content="Full desktop" Click="ToggleDesktopMode_Click"
                            ToolTip="Maximise or restore the reading workspace (F11)" Margin="0,0,10,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="INFOSEC FEED" Foreground="{StaticResource AccentBrush}"
                               FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" />
                    <TextBlock Text="Security intelligence without the noise"
                               FontSize="{DynamicResource TextHero}" FontWeight="SemiBold" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="FilterBorder" Grid.Row="1" Padding="24,14" Background="{StaticResource PanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search titles, summaries, sources and severities"
                             AutomationProperties.Name="Search security intelligence" />
                    <TextBlock Text="Search CVEs, threats, sources…" Margin="13,0" VerticalAlignment="Center"
                               Foreground="#8092A5" IsHitTestVisible="False"
                               FontSize="{DynamicResource TextControl}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel Width="190" Margin="0,0,14,0">
                        <TextBlock Text="Category" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource TextSmall}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  AutomationProperties.Name="Feed category" />
                    </StackPanel>
                    <StackPanel Width="230" Margin="0,0,14,0">
                        <TextBlock Text="Desktop alerts" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource TextSmall}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding AlertChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Mode" SelectedValue="{Binding SelectedAlertMode}"
                                  AutomationProperties.Name="Desktop alert threshold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Text size" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource TextSmall}" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="A−" Command="{Binding DecreaseTextCommand}" Padding="11,7"
                                    ToolTip="Make text smaller (Ctrl+-)" AutomationProperties.Name="Decrease text size" />
                            <Slider Width="165" Minimum="0.9" Maximum="1.6" TickFrequency="0.1"
                                    SmallChange="0.1" LargeChange="0.1" IsSnapToTickEnabled="True"
                                    Value="{Binding TextScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="10,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Text size" />
                            <Button Content="A+" Command="{Binding IncreaseTextCommand}" Padding="11,7"
                                    ToolTip="Make text larger (Ctrl++)" AutomationProperties.Name="Increase text size" />
                            <TextBlock Text="{Binding TextScaleLabel}" Width="52" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="{DynamicResource TextSmall}" />
                            <Button Content="Reset" Command="{Binding ResetTextCommand}" Padding="11,7"
                                    ToolTip="Reset text size (Ctrl+0)" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <ListBox x:Name="CardsList" Grid.Row="2" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Padding="20,12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Margin="4,5" Padding="0"
                            BorderBrush="#263747" BorderThickness="1" MaxWidth="{DynamicResource CardMaxWidth}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="{DynamicResource CardImageWidth}"
                                    Height="{DynamicResource CardImageHeight}" Margin="0"
                                    CornerRadius="14,0,0,14" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                            </Border>
                            <Grid Margin="{DynamicResource CardContentMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" />
                                    <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSeverity}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="EXPLOITED">
                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Severity}" Foreground="#0B1016"
                                                   FontSize="{DynamicResource TextXs}" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource TextTitle}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" Margin="0,7,0,4"
                                           MaxHeight="{DynamicResource TitleMaxHeight}" />
                                <TextBlock Grid.Row="2" Text="{Binding Summary}" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource TextBody}"
                                           MaxHeight="{DynamicResource SummaryMaxHeight}" />
                                <DockPanel Grid.Row="3" Margin="0,9,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource TextSmall}">
                                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Age, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button DockPanel.Dock="Right" Content="Open article" Command="{Binding OpenCommand}"
                                            Padding="12,6" FontSize="{DynamicResource TextSmall}" />
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Background="#0D141D" BorderBrush="#263543" BorderThickness="0,1,0,0" Padding="24,9">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="{DynamicResource TextSmall}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
