<Window x:Class="InfoSecFeed.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="InfoSec Feed" Width="1180" Height="820" MinWidth="760" MinHeight="540"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D141D" BorderBrush="#263543" BorderThickness="0,0,0,1" Padding="24,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="INFOSEC FEED" Foreground="{StaticResource AccentBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Security intelligence without the noise"
                               FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="24,14" Background="{StaticResource PanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search titles, summaries, sources and severities" FontSize="15" />
                    <TextBlock Text="Search CVEs, threats, sources…" Margin="13,0" VerticalAlignment="Center"
                               Foreground="#8092A5" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}" Margin="0,0,12,0" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Desktop alerts" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                    <ComboBox ItemsSource="{Binding AlertChoices}" DisplayMemberPath="Label"
                              SelectedValuePath="Mode" SelectedValue="{Binding SelectedAlertMode}" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Padding="20,12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Margin="4,5" Padding="0"
                            BorderBrush="#263747" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="250" Height="155" Margin="0"
                                    CornerRadius="14,0,0,14" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                            </Border>
                            <Grid Margin="20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSeverity}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="EXPLOITED">
                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Severity}" Foreground="#0B1016" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="18"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" Margin="0,7,0,4" MaxHeight="52" />
                                <TextBlock Grid.Row="2" Text="{Binding Summary}" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" MaxHeight="42" />
                                <DockPanel Grid.Row="3" Margin="0,9,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12">
                                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Age, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button DockPanel.Dock="Right" Content="Open article" Command="{Binding OpenCommand}"
                                            Padding="12,6" FontSize="12" />
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Background="#0D141D" BorderBrush="#263543" BorderThickness="0,1,0,0" Padding="24,9">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
